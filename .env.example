JWT_SECRET=replace_with_strong_secret

# Password Hashing with Bcrypt
# Cost factor: must be 12-31, default 12 (industry standard)
# Cost 12 = ~40-80ms per hash (recommended)
# Cost 13+ = more secure but slower logins
# See acceptance criteria for rationale
BCRYPT_COST_FACTOR=12

POSTGRES_DB=commit-crew-db
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_HOST=10.9.75.153
POSTGRES_PORT=5432


KAFKA_PORT=9094
KAFKA_UI_PORT=8090

ENGINE_MIN_DELAY=500ms
ENGINE_MAX_DELAY=2000ms
ENGINE_MAX_PRICE_IMPROVEMENT_BPS=50
